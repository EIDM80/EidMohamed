# Copy to .env and fill in.  cp .env.example .env   (PowerShell: Copy-Item .env.example .env)

# Long random string. Sessions are invalidated if you change it later.
# Generate one:  powershell -c "[guid]::NewGuid().ToString() + [guid]::NewGuid().ToString()"
WEBUI_SECRET_KEY=

# Keep true. Setting false makes the UI reachable with no login at all —
# and it listens on your network, not just this PC.
WEBUI_AUTH=true

# Host port for the Open WebUI interface.
OPEN_WEBUI_PORT=3000
