# ---- Gateway ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_SECRET_KEY=change-me-to-a-long-random-string
GATEWAY_TOKEN_TTL_MINUTES=720
GATEWAY_DATABASE_URL=postgresql+psycopg://gateway:gateway@localhost:5432/gateway
# For local development without Postgres:
# GATEWAY_DATABASE_URL=sqlite+pysqlite:///./gateway.db

# Origins your own frontend is served from. Leave empty to disable CORS.
CORS_ORIGINS=http://localhost:3000
# Serve the bundled dashboard at /app. Turn off if you ship your own frontend.
SERVE_DASHBOARD=true

# ---- Admin API ----
# Empty disables the provisioning routes entirely (they answer 404).
ADMIN_API_KEY=

# ---- Billing webhook ----
# Empty disables the webhook route entirely.
BILLING_WEBHOOK_SECRET=
BILLING_WEBHOOK_TOLERANCE_SECONDS=300
# Provider price id to plan key. Adding a price is an env change, not a deploy.
BILLING_PRICE_MAP=price_xxx:pro,price_yyy:enterprise

# ---- Dify (never exposed to customers) ----
DIFY_BASE_URL=http://localhost/v1
DIFY_TIMEOUT_SECONDS=120
# Must match the metadata field name in Dify AND the retrieval filter condition.
DIFY_TENANT_METADATA_FIELD=tenant_id

# ---- Rate limiting (Dify's own limiter is cloud-only) ----
# Per-plan values in app/plans.py take precedence; this is the fallback.
RATE_LIMIT_PER_MINUTE=30
# Required once you run more than one worker — otherwise each process
# enforces its own separate allowance.
REDIS_URL=

# ---- Uploads ----
MAX_UPLOAD_MB=25

# ---- Ops ----
LOG_LEVEL=INFO
JSON_LOGS=false

# In production, prefer files over env for the three secrets above: mount them
# at /run/secrets/gateway_secret_key, /run/secrets/admin_api_key and
# /run/secrets/billing_webhook_secret. See docker-compose.prod.yml.
