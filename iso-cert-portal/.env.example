# Gemini API Key for server-side AI requests (summarizing standards, generating certificates)
GEMINI_API_KEY=

# Supabase project (client-side; the anon/publishable key is safe to expose in the browser bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase service_role key — SERVER-ONLY, never expose client-side. Lets the
# Stripe webhook write a request row after payment, bypassing RLS. Find it in
# Supabase: Project Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server-only). Secret key from the Stripe Dashboard (Developers > API keys).
STRIPE_SECRET_KEY=
# Signing secret for the /api/stripe/webhook endpoint (Developers > Webhooks
# > select the endpoint > Signing secret). Only available after the webhook
# endpoint has been created in the Stripe Dashboard pointing at your deployed
# URL + /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# Resend (server-only). API key from resend.com — used to email training
# course leads to iso@gloria-c.com.
RESEND_API_KEY=
# Optional override. Defaults to "GAMC Website <noreply@gloria-c.com>" now
# that gloria-c.com is verified on Resend.
RESEND_FROM_EMAIL=
