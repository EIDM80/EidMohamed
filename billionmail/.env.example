# Reference only. deploy.sh generates the real /opt/billionmail/.env with random secrets.
# Never commit a filled-in .env.

ADMIN_USERNAME=admin-change-me
ADMIN_PASSWORD=CHANGE_ME_20_chars_min
# panel lives at https://<host>/<SafePath>
SafePath=CHANGE_ME_random

BILLIONMAIL_HOSTNAME=mail.yourdomain.com

DBNAME=billionmail
DBUSER=billionmail
DBPASS=CHANGE_ME_32_chars
REDISPASS=CHANGE_ME_32_chars

SMTP_PORT=25
SMTPS_PORT=465
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993
POP_PORT=110
POPS_PORT=995
# keep on 127.0.0.1
REDIS_PORT=127.0.0.1:26379
# keep on 127.0.0.1
SQL_PORT=127.0.0.1:25432

# 80 is needed for Let's Encrypt
HTTP_PORT=80
HTTPS_PORT=443

WEB_BASE_PATH=
AAPANEL_SSO_SECRET=
TZ=Africa/Cairo
IPV4_NETWORK=172.66.1
FAIL2BAN_INIT=y
IP_WHITELIST_ENABLE=false
RETENTION_DAYS=7
